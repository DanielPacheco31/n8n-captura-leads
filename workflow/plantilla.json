{
  "name": "SOMOSBITS_ | Captura de leads del formulario web",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook formulario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "5f0c6c1e-3b7a-4d2e-9a10-somosbits0001",
      "parameters": {
        "httpMethod": "POST",
        "path": "leads-somosbits",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validar y normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "jsCode": ""
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "¿Es válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c0nd-0001",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Guardar en Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [720, 200],
      "notes": "appendOrUpdate con columna de coincidencia 'email': si el cliente vuelve a escribir se actualiza su fila en vez de duplicarla.",
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "REEMPLAZAR_ID_DE_LA_HOJA" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $json.lead.fecha }}",
            "nombre": "={{ $json.lead.nombre }}",
            "email": "={{ $json.lead.email }}",
            "telefono": "={{ $json.lead.telefono }}",
            "servicio": "={{ $json.lead.servicio }}",
            "mensaje": "={{ $json.lead.mensaje }}",
            "origen": "={{ $json.lead.origen }}",
            "estado": "={{ $json.lead.estado }}"
          },
          "matchingColumns": ["email"],
          "schema": [
            { "id": "fecha", "displayName": "fecha", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "nombre", "displayName": "nombre", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "email", "displayName": "email", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "telefono", "displayName": "telefono", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "servicio", "displayName": "servicio", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "mensaje", "displayName": "mensaje", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "origen", "displayName": "origen", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "estado", "displayName": "estado", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Respuesta al cliente (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 200],
      "onError": "continueRegularOutput",
      "parameters": {
        "sendTo": "={{ $('Validar y normalizar').item.json.lead.email }}",
        "subject": "Recibimos tu solicitud – SOMOSBITS_",
        "emailType": "text",
        "message": "=Hola {{ $('Validar y normalizar').item.json.lead.nombre }},\n\nGracias por escribirnos. Recibimos tu solicitud sobre \"{{ $('Validar y normalizar').item.json.lead.servicio }}\" y te contactaremos en menos de 24 horas hábiles.\n\nSi es urgente, respóndenos a este correo.\n\nEquipo SOMOSBITS_",
        "options": { "appendAttribution": false }
      }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Aviso interno (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 200],
      "onError": "continueRegularOutput",
      "parameters": {
        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "=🟢 <b>Nuevo lead</b>\n<b>Nombre:</b> {{ $('Validar y normalizar').item.json.lead.nombre }}\n<b>Servicio:</b> {{ $('Validar y normalizar').item.json.lead.servicio }}\n<b>Email:</b> {{ $('Validar y normalizar').item.json.lead.email }}\n<b>Tel:</b> {{ $('Validar y normalizar').item.json.lead.telefono || '—' }}\n\n{{ $('Validar y normalizar').item.json.lead.mensaje }}",
        "additionalFields": { "parse_mode": "HTML", "appendAttribution": false }
      }
    },
    {
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Responder 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, errores: $json.errores }) }}",
        "options": { "responseCode": 400 }
      }
    }
  ],
  "connections": {
    "Webhook formulario": { "main": [[{ "node": "Validar y normalizar", "type": "main", "index": 0 }]] },
    "Validar y normalizar": { "main": [[{ "node": "¿Es válido?", "type": "main", "index": 0 }]] },
    "¿Es válido?": {
      "main": [
        [{ "node": "Guardar en Google Sheets", "type": "main", "index": 0 }],
        [{ "node": "Responder 400", "type": "main", "index": 0 }]
      ]
    },
    "Guardar en Google Sheets": { "main": [[{ "node": "Respuesta al cliente (Gmail)", "type": "main", "index": 0 }]] },
    "Respuesta al cliente (Gmail)": { "main": [[{ "node": "Aviso interno (Telegram)", "type": "main", "index": 0 }]] },
    "Aviso interno (Telegram)": { "main": [[{ "node": "Responder 200", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
